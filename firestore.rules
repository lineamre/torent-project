rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: authenticated users can only access their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User readings subcollection: users only own their private readings
      match /readings/{readingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User daily solar draws subcollection
      match /daily_draws/{drawId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User card reflections/notes subcollection
      match /card_notes/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
